# Public configuration: copy the values from your own Lovable/Supabase project.
# Lovable requires the root .env to remain versioned for previews and builds.
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only credentials: configure them in your hosting secrets manager.
# For local development, use an ignored .env.local file. Never commit real values.
# Never prefix a private credential with VITE_.
# SUPABASE_SERVICE_ROLE_KEY=
# GEMINI_API_KEY=
# GEMINI_MODEL=
# GROQ_API_KEY=
# LOVABLE_DB_MIGRATION_URL=
